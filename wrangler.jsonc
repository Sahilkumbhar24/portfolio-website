// Cloudflare Workers config: serve the built static site from dist/ with no Worker script.
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "sahil-kumbhar-portfolio",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
